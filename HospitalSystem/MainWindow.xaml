<Window x:Class="HospitalSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HospitalSystem"
        mc:Ignorable="d"
        Title="Система обліку пацієнтів лікарні"
        Height="550"
        Width="980"
        MinWidth="900"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button x:Name="AddPatientButton" Width="120" Height="35" Margin="0,0,10,0" Content="Додати" Click="AddPatientButton_Click"/>
            <Button x:Name="EditPatientButton" Width="120" Height="35" Margin="0,0,10,0" Content="Редагувати" Click="EditPatientButton_Click"/>
            <Button x:Name="DischargePatientButton" Width="120" Height="35" Margin="0,0,10,0" Content="Виписати" Click="DischargePatientButton_Click"/>
            <Button x:Name="LoadFromServerButton" Width="150" Height="35" Margin="0,0,10,0" Content="Завантажити з сервера" Click="LoadFromServerButton_Click"/>
            <Button x:Name="SyncWithServerButton" Width="140" Height="35" Content="Синхронізувати" Click="SyncWithServerButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="PatientsDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F7F7F7"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="ПІБ" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Вік" Binding="{Binding Age}" Width="80"/>
                <DataGridTextColumn Header="Діагноз" Binding="{Binding Diagnosis}" Width="*"/>
                <DataGridTextColumn Header="Лікар" Binding="{Binding Doctor}" Width="*"/>
                <DataGridTextColumn Header="Кімната" Binding="{Binding Room}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
